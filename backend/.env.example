# ── App ────────────────────────────────────────────────
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5000

# ── Supabase (demo/registration funnel) ──────────────────
# Project Settings → API. Use the SERVICE ROLE key (server-side only, never expose to frontend).
# IMPORTANT: base project URL only — do NOT append /rest/v1/ (the client adds it).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gmail (Nodemailer transactional email) ───────────────
# Requires 2-Step Verification + a Gmail App Password (myaccount.google.com/apppasswords).
# Use the 16-char App Password, NOT your normal Gmail password.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
MAIL_FROM=Pet Hospital Portal <youraddress@gmail.com>

# ── Cal.com (demo scheduling → Google Meet link) ─────────
# API key: Cal.com → Settings → Developer → API Keys. Event location must be Google Meet.
CALCOM_API_KEY=cal_live_...
CALCOM_EVENT_TYPE_ID=123456
CALCOM_TIMEZONE=Asia/Calcutta

# ── Stripe (test mode) ───────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
DEMO_PRICE_AMOUNT=4900
DEMO_PRICE_CURRENCY=usd
