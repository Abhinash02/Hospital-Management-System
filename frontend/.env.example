# Backend API base URL (no trailing slash). In production set this to your deployed
# backend URL, e.g. https://pet-hospital-api.onrender.com
VITE_API_URL=http://localhost:5000

# Cal.com event link used by the demo scheduling embed, e.g. "yourname/30min"
# Set the event location to "Google Meet" in your Cal.com event type to get Google Meet links.
VITE_CALCOM_LINK=
